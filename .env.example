# Application
APP_NAME=Personal News Agent
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
TIMEZONE=Asia/Singapore
API_PREFIX=/api

# Infrastructure (use service names when running through Docker Compose)
DATABASE_URL=postgresql+asyncpg://news_agent:change-me@postgres:5432/news_agent
REDIS_URL=redis://redis:6379/0

# News deduplication (0..1)
DEDUP_SIMILARITY_THRESHOLD=0.78
DEDUP_EMBEDDING_THRESHOLD=0.85

# DeepSeek LLM
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT=45
LLM_MAX_RETRIES=3
LLM_BACKOFF_FACTOR=0.5

# Application wiring
ENABLE_SCHEDULER=false
WECHAT_GATEWAY_ENDPOINT=
WECHAT_GATEWAY_TOKEN=
WECHAT_RECIPIENT=
WECHAT_WEBHOOK_TOKEN=
WECHAT_MESSAGE_MAX_CHARS=3500

# External credentials (never commit real values)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
WECHAT_APP_ID=
WECHAT_APP_SECRET=
ADMIN_API_KEY=
